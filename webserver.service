[Unit]
Description=web interface
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=simple
User=door
Group=door
SupplementaryGroups=gpio
WorkingDirectory=/srv/door
EnvironmentFile=/etc/door.env
Environment=GPIOZERO_PIN_FACTORY=lgpio
ExecStart=/srv/door/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 80 --workers 1 --no-proxy-headers --no-access-log --log-level error

StandardOutput=journal
StandardError=journal
SyslogIdentifier=door

Restart=on-failure
RestartSec=5

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

StateDirectory=door
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

DevicePolicy=closed
DeviceAllow=/dev/gpiochip0 rw

[Install]
WantedBy=multi-user.target
